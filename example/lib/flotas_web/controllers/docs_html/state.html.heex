<Layouts.docs flash={@flash} current_page={@current_page}>
  <div class="breadcrumbs text-sm mb-6">
    <ul>
      <li><a href="/docs/quick-start">Docs</a></li>
      <li>State Management</li>
    </ul>
  </div>

  <h1 class="text-4xl font-bold text-base-content mb-8">State Management</h1>

  <section id="state-struct" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#state-struct" class="hover:text-primary">The State Struct</a>
    </h2>
    <p class="text-base-content/70 mb-6">
      LiveFlow follows the XYFlow change pattern: JS detects user interactions, sends change lists
      to the server, and the server applies them to the state.
    </p>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">%LiveFlow.State{
  nodes: %{"id" =&gt; %Node{}},           # Map of nodes by ID
  edges: %{"id" =&gt; %Edge{}},           # Map of edges by ID
  viewport: %Viewport{x: 0, y: 0, zoom: 1.0},
  selected_nodes: MapSet.new(),        # Set of selected node IDs
  selected_edges: MapSet.new()         # Set of selected edge IDs
}</code></pre>
  </section>

  <section id="applying-changes" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#applying-changes" class="hover:text-primary">Applying Changes from JS</a>
    </h2>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Changes.{NodeChange, EdgeChange}

# Handle node changes (position, dimensions, select, remove)
def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
  flow = NodeChange.apply_changes(socket.assigns.flow, changes)
  {:noreply, assign(socket, flow: flow)}
end

# Handle edge changes (add, remove, select)
def handle_event("lf:edge_change", %{"changes" =&gt; changes}, socket) do
  flow = EdgeChange.apply_changes(socket.assigns.flow, changes)
  {:noreply, assign(socket, flow: flow)}
end</code></pre>
  </section>

  <section id="change-types" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#change-types" class="hover:text-primary">Change Types</a>
    </h2>
    <p class="text-base-content/70 mb-4">
      Node changes can include:
    </p>
    <ul class="list-disc list-inside text-base-content/70 space-y-1 mb-4">
      <li><strong>position</strong> — node moved to new x, y</li>
      <li><strong>dimensions</strong> — node width/height measured by ResizeObserver</li>
      <li><strong>select</strong> — node selected or deselected</li>
      <li><strong>remove</strong> — node deleted</li>
    </ul>
  </section>

  <section id="data-flow" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#data-flow" class="hover:text-primary">Data Flow Architecture</a>
    </h2>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6"><code class="text-base-content">User Action
  → JS Manager (optimistic UI update)
  → pushEventTo("lf:event_name", data)
  → LiveComponent.handle_event/3
  → State update
  → DOM patch
  → Hook.updated()
  → Re-measure nodes if needed</code></pre>

    <div class="alert alert-info mt-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm">
        <span class="font-semibold">Optimistic updates:</span> During drag, node positions are updated via CSS
        <code>style.left/top</code> directly — no server roundtrips. Edge SVG paths are recalculated in JS
        to keep them visually connected. The final position is only sent once on drag end.
      </p>
    </div>
  </section>

  <section id="history" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#history" class="hover:text-primary">History (Undo/Redo)</a>
    </h2>
    <p class="text-base-content/70 mb-6">
      LiveFlow includes a built-in history system for undo/redo functionality using snapshot stacks.
    </p>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.History

# Initialize history in mount
def mount(_params, _session, socket) do
  flow = LiveFlow.create_flow(nodes: nodes, edges: edges)
  history = History.new()

  {:ok, assign(socket, flow: flow, history: history)}
end

# Push state to history before changes
def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
  history = History.push(socket.assigns.history, socket.assigns.flow)
  flow = NodeChange.apply_changes(socket.assigns.flow, changes)

  {:noreply, assign(socket, flow: flow, history: history)}
end

# Undo
def handle_event("lf:undo", _params, socket) do
  case History.undo(socket.assigns.history, socket.assigns.flow) do
    {:ok, flow, history} -&gt;
      {:noreply, assign(socket, flow: flow, history: history)}
    :error -&gt;
      {:noreply, socket}
  end
end

# Redo
def handle_event("lf:redo", _params, socket) do
  case History.redo(socket.assigns.history, socket.assigns.flow) do
    {:ok, flow, history} -&gt;
      {:noreply, assign(socket, flow: flow, history: history)}
    :error -&gt;
      {:noreply, socket}
  end
end</code></pre>
  </section>

  <section id="clipboard" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#clipboard" class="hover:text-primary">Clipboard (Copy/Cut/Paste)</a>
    </h2>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Clipboard

# Initialize clipboard in mount
def mount(_params, _session, socket) do
  {:ok, assign(socket, clipboard: Clipboard.new(), paste_count: 0)}
end

# Copy selected nodes/edges
def handle_event("lf:copy", _params, socket) do
  {clipboard, flow} = Clipboard.copy(socket.assigns.flow, socket.assigns.clipboard)
  {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
end

# Cut selected nodes/edges
def handle_event("lf:cut", _params, socket) do
  {clipboard, flow} = Clipboard.cut(socket.assigns.flow, socket.assigns.clipboard)
  {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
end

# Paste with offset
def handle_event("lf:paste", _params, socket) do
  paste_count = socket.assigns.paste_count + 1
  {flow, clipboard} = Clipboard.paste(
    socket.assigns.flow,
    socket.assigns.clipboard,
    paste_count
  )
  {:noreply, assign(socket, flow: flow, clipboard: clipboard, paste_count: paste_count)}
end</code></pre>
  </section>

  <section id="serialization" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#serialization" class="hover:text-primary">Serialization (Import/Export)</a>
    </h2>
    <p class="text-base-content/70 mb-6">
      Export your flow as JSON for persistence, or import from JSON to restore a flow.
    </p>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Serializer

# Export to JSON string
json = Serializer.to_json(flow)

# Import from JSON string
{:ok, flow} = Serializer.from_json(json)

# Export as file download (push to JS)
def handle_event("export", _params, socket) do
  json = Serializer.to_json(socket.assigns.flow)
  {:noreply, push_event(socket, "phx:lf:download_file", %{
    content: json,
    filename: "my-flow.json",
    content_type: "application/json"
  })}
end

# Import from file upload
def handle_event("import", %{"json" =&gt; json}, socket) do
  case Serializer.from_json(json) do
    {:ok, flow} -&gt;
      {:noreply, assign(socket, flow: flow)}
    {:error, reason} -&gt;
      {:noreply, put_flash(socket, :error, "Import failed: #{reason}")}
  end
end</code></pre>

    <div class="alert alert-info mt-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm">
        For file import, use the <code>FileImportHook</code> registered in your app.js.
        It provides a file input that reads the JSON content and pushes it to the server.
      </p>
    </div>
  </section>

  <%!-- Prev/Next Navigation --%>
  <div class="flex justify-between pt-8 border-t border-base-300">
    <a href="/docs/viewport" class="btn btn-ghost gap-2">
      <span aria-hidden="true">&larr;</span> Viewport & Controls
    </a>
    <a href="/docs/advanced" class="btn btn-ghost gap-2">
      Advanced Features <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</Layouts.docs>
