<Layouts.docs flash={@flash} current_page={@current_page}>
  <div class="breadcrumbs text-sm mb-6">
    <ul>
      <li><a href="/docs/quick-start">Docs</a></li>
      <li>API Reference</li>
    </ul>
  </div>

  <h1 class="text-4xl font-bold text-base-content mb-8">API Reference</h1>

  <section id="js-architecture" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#js-architecture" class="hover:text-primary">JavaScript Architecture</a>
    </h2>
    <p class="text-base-content/70 mb-6">
      The JavaScript layer handles all client-side interactions through a modular manager system,
      orchestrated by the main <code>LiveFlowHook</code>.
    </p>

    <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Manager System</h3>
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr><th>Manager</th><th>Responsibility</th></tr>
        </thead>
        <tbody>
          <tr><td><code>PanZoomManager</code></td><td>Canvas panning and zooming with wheel/touch events</td></tr>
          <tr><td><code>NodeDragManager</code></td><td>Node dragging with CSS transforms, multi-select drag</td></tr>
          <tr><td><code>ConnectionManager</code></td><td>Drawing connections between handles with preview line</td></tr>
          <tr><td><code>SelectionManager</code></td><td>Click and rubber-band selection</td></tr>
          <tr><td><code>CursorManager</code></td><td>Remote cursor rendering for collaboration</td></tr>
          <tr><td><code>HelperLinesManager</code></td><td>Snap alignment guides during drag</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="js-to-server" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#js-to-server" class="hover:text-primary">Event Flow (JS → Server)</a>
    </h2>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">// All events use pushEventTo to target the LiveComponent
this.pushEventTo(this.el, "lf:node_change", {changes: [...]})
this.pushEventTo(this.el, "lf:edge_change", {changes: [...]})
this.pushEventTo(this.el, "lf:viewport_change", {viewport: {...}})
this.pushEventTo(this.el, "lf:connect_end", {source, target, ...})
this.pushEventTo(this.el, "lf:delete_selected", {})
this.pushEventTo(this.el, "lf:undo", {})
this.pushEventTo(this.el, "lf:redo", {})</code></pre>
  </section>

  <section id="server-to-js" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#server-to-js" class="hover:text-primary">Event Flow (Server → JS)</a>
    </h2>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">// Server pushes events that JS handles
push_event(socket, "lf:fit_view", %{padding: 50})
push_event(socket, "lf:zoom_to", %{zoom: 1.5})
push_event(socket, "lf:pan_to", %{x: 100, y: 200})
push_event(socket, "lf:remote_cursor", %{user_id, x, y, color, name})
push_event(socket, "lf:remote_drag", %{changes: [...]})
push_event(socket, "lf:layout_data", layout_data)</code></pre>
  </section>

  <section id="node-measurement" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#node-measurement" class="hover:text-primary">Node Measurement</a>
    </h2>
    <p class="text-base-content/70 mb-4">
      Nodes are automatically measured using <code>ResizeObserver</code> when they appear in the DOM.
      A <code>MutationObserver</code> detects new nodes and triggers measurement. The measured dimensions
      are sent back to the server as dimension changes.
    </p>
  </section>

  <section id="performance" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#performance" class="hover:text-primary">Performance Optimizations</a>
    </h2>
    <ul class="list-disc list-inside text-base-content/70 space-y-2">
      <li><strong>Direct CSS updates during drag</strong> — node positions use <code>style.left/top</code> without server roundtrips</li>
      <li><strong>JS edge path recalculation</strong> — edge SVG paths update in JS during drag to stay visually connected</li>
      <li><strong>Final position on drag end</strong> — only the final position is sent to the server</li>
      <li><strong>Throttled cursor updates</strong> — collaboration cursors throttled at 50ms</li>
      <li><strong>Lerp interpolation</strong> — smooth remote animations via <code>requestAnimationFrame</code></li>
    </ul>
  </section>

  <section id="theming" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#theming" class="hover:text-primary">Theming</a>
    </h2>
    <p class="text-base-content/70 mb-6">
      LiveFlow uses CSS custom properties for theming via the <code class="badge badge-ghost">data-lf-theme</code>
      attribute. You can use built-in themes or create custom ones.
    </p>

    <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Using Themes</h3>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">&lt;.live_component
  module={LiveFlow.Components.Flow}
  id="my-flow"
  flow={@flow}
  theme="dark"      # "dark" | "light" | custom name
/&gt;</code></pre>

    <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">CSS Custom Properties</h3>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">/* Create a custom theme */
[data-lf-theme="my-theme"] {
  --lf-background: #1a1a2e;
  --lf-node-background: #16213e;
  --lf-node-border: #0f3460;
  --lf-node-text: #e2e8f0;
  --lf-edge-stroke: #4a5568;
  --lf-edge-stroke-selected: #63b3ed;
  --lf-handle-background: #4299e1;
  --lf-handle-border: #2b6cb0;
  --lf-selection-background: rgba(66, 153, 225, 0.1);
  --lf-minimap-background: #2d3748;
  --lf-controls-background: #2d3748;
  --lf-grid-pattern: #2d3748;
}</code></pre>
  </section>

  <section id="event-reference" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#event-reference" class="hover:text-primary">Complete Event Reference</a>
    </h2>

    <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">JS → Server Events</h3>
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr><th>Event</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr><td><code>lf:node_change</code></td><td>Position, dimensions, select, remove changes</td></tr>
          <tr><td><code>lf:edge_change</code></td><td>Add, remove, select edge changes</td></tr>
          <tr><td><code>lf:viewport_change</code></td><td>Pan/zoom viewport updates</td></tr>
          <tr><td><code>lf:connect_start</code></td><td>User starts dragging from a handle</td></tr>
          <tr><td><code>lf:connect_move</code></td><td>Connection line being drawn</td></tr>
          <tr><td><code>lf:connect_end</code></td><td>Connection completed on target handle</td></tr>
          <tr><td><code>lf:connect_cancel</code></td><td>Connection dropped on empty space</td></tr>
          <tr><td><code>lf:selection_change</code></td><td>Selection state changed</td></tr>
          <tr><td><code>lf:selection_box_start/move/end</code></td><td>Rubber-band selection</td></tr>
          <tr><td><code>lf:delete_selected</code></td><td>Delete/Backspace key pressed</td></tr>
          <tr><td><code>lf:undo</code></td><td>Ctrl+Z pressed</td></tr>
          <tr><td><code>lf:redo</code></td><td>Ctrl+Shift+Z pressed</td></tr>
          <tr><td><code>lf:copy</code></td><td>Ctrl+C pressed</td></tr>
          <tr><td><code>lf:cut</code></td><td>Ctrl+X pressed</td></tr>
          <tr><td><code>lf:paste</code></td><td>Ctrl+V pressed</td></tr>
          <tr><td><code>lf:duplicate</code></td><td>Ctrl+D pressed</td></tr>
          <tr><td><code>lf:edge_label_change</code></td><td>Inline edge label edited</td></tr>
          <tr><td><code>lf:insert_on_edge</code></td><td>"+" button clicked on edge</td></tr>
          <tr><td><code>lf:cursor_move</code></td><td>Cursor position (collaboration)</td></tr>
          <tr><td><code>lf:drag_move</code></td><td>Drag position broadcast (collaboration)</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Server → JS Events</h3>
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr><th>Event</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr><td><code>lf:fit_view</code></td><td>Fit all nodes in viewport</td></tr>
          <tr><td><code>lf:zoom_to</code></td><td>Set zoom level</td></tr>
          <tr><td><code>lf:pan_to</code></td><td>Pan to position</td></tr>
          <tr><td><code>lf:set_viewport</code></td><td>Set exact viewport state</td></tr>
          <tr><td><code>lf:remote_cursor</code></td><td>Render remote user cursor</td></tr>
          <tr><td><code>lf:cursor_leave</code></td><td>Remove remote cursor</td></tr>
          <tr><td><code>lf:remote_drag</code></td><td>Animate remote node drag</td></tr>
          <tr><td><code>lf:layout_data</code></td><td>Trigger ELK auto-layout</td></tr>
          <tr><td><code>phx:lf:download_file</code></td><td>Trigger file download</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="complete-pattern" class="scroll-mt-8 mb-12">
    <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-300 pb-2">
      <a href="#complete-pattern" class="hover:text-primary">Complete LiveView Pattern</a>
    </h2>
    <p class="text-base-content/70 mb-6">
      Here's a full-featured LiveView showing how to handle all LiveFlow events:
    </p>
    <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm" phx-no-curly-interpolation><code class="text-base-content">defmodule MyAppWeb.FlowEditorLive do
  use MyAppWeb, :live_view

  alias LiveFlow
  alias LiveFlow.State
  alias LiveFlow.History
  alias LiveFlow.Clipboard
  alias LiveFlow.Serializer
  alias LiveFlow.Validation
  alias LiveFlow.Changes.{NodeChange, EdgeChange}

  @validators [:no_duplicate_edges, :nodes_exist, :handles_valid, :no_cycles]

  @impl true
  def mount(_params, _session, socket) do
    nodes = [
      LiveFlow.new_node("1", %{x: 0, y: 0}, %{label: "Start"}),
      LiveFlow.new_node("2", %{x: 300, y: 100}, %{label: "End"})
    ]
    edges = [LiveFlow.new_edge("1", "2", "e1-2")]
    flow = LiveFlow.create_flow(nodes: nodes, edges: edges)

    {:ok, assign(socket,
      flow: flow,
      history: History.new(),
      clipboard: Clipboard.new(),
      paste_count: 0
    )}
  end

  @impl true
  def render(assigns) do
    ~H"""
    &lt;Layouts.app flash={@flash}&gt;
      &lt;div style="width: 100%; height: 90vh;"&gt;
        &lt;.live_component
          module={LiveFlow.Components.Flow}
          id="editor"
          flow={@flow}
          background={:dots}
          minimap={true}
          controls={true}
          helper_lines={true}
        /&gt;
      &lt;/div&gt;
    &lt;/Layouts.app&gt;
    """
  end

  # --- Node Changes ---
  @impl true
  def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
    history = History.push(socket.assigns.history, socket.assigns.flow)
    flow = NodeChange.apply_changes(socket.assigns.flow, changes)
    {:noreply, assign(socket, flow: flow, history: history)}
  end

  # --- Edge Changes ---
  def handle_event("lf:edge_change", %{"changes" =&gt; changes}, socket) do
    history = History.push(socket.assigns.history, socket.assigns.flow)
    flow = EdgeChange.apply_changes(socket.assigns.flow, changes)
    {:noreply, assign(socket, flow: flow, history: history)}
  end

  # --- Connection ---
  def handle_event("lf:connect_end", params, socket) do
    case Validation.Connection.validate_and_create(
      socket.assigns.flow, params, @validators
    ) do
      {:ok, edge} -&gt;
        history = History.push(socket.assigns.history, socket.assigns.flow)
        flow = State.add_edge(socket.assigns.flow, edge)
        {:noreply, assign(socket, flow: flow, history: history)}
      {:error, _reason} -&gt;
        {:noreply, socket}
    end
  end

  # --- Delete ---
  def handle_event("lf:delete_selected", _params, socket) do
    history = History.push(socket.assigns.history, socket.assigns.flow)
    flow = State.delete_selected(socket.assigns.flow)
    {:noreply, assign(socket, flow: flow, history: history)}
  end

  # --- Undo/Redo ---
  def handle_event("lf:undo", _params, socket) do
    case History.undo(socket.assigns.history, socket.assigns.flow) do
      {:ok, flow, history} -&gt;
        {:noreply, assign(socket, flow: flow, history: history)}
      :error -&gt; {:noreply, socket}
    end
  end

  def handle_event("lf:redo", _params, socket) do
    case History.redo(socket.assigns.history, socket.assigns.flow) do
      {:ok, flow, history} -&gt;
        {:noreply, assign(socket, flow: flow, history: history)}
      :error -&gt; {:noreply, socket}
    end
  end

  # --- Clipboard ---
  def handle_event("lf:copy", _p, socket) do
    {clipboard, flow} = Clipboard.copy(socket.assigns.flow, socket.assigns.clipboard)
    {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
  end

  def handle_event("lf:cut", _p, socket) do
    {clipboard, flow} = Clipboard.cut(socket.assigns.flow, socket.assigns.clipboard)
    {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
  end

  def handle_event("lf:paste", _p, socket) do
    pc = socket.assigns.paste_count + 1
    {flow, clipboard} = Clipboard.paste(socket.assigns.flow, socket.assigns.clipboard, pc)
    {:noreply, assign(socket, flow: flow, clipboard: clipboard, paste_count: pc)}
  end

  # --- Export ---
  def handle_event("export", _p, socket) do
    json = Serializer.to_json(socket.assigns.flow)
    {:noreply, push_event(socket, "phx:lf:download_file", %{
      content: json, filename: "flow.json", content_type: "application/json"
    })}
  end

  # --- Catch-all for unhandled lf: events ---
  def handle_event("lf:" &lt;&gt; _event, _params, socket) do
    {:noreply, socket}
  end
end</code></pre>
  </section>

  <%!-- Prev/Next Navigation --%>
  <div class="flex justify-start pt-8 border-t border-base-300">
    <a href="/docs/advanced" class="btn btn-ghost gap-2">
      <span aria-hidden="true">&larr;</span> Advanced Features
    </a>
  </div>
</Layouts.docs>
