<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-100">
  <%!-- Hero Section --%>
  <div class="bg-gradient-to-b from-primary/5 to-base-100 border-b border-base-300">
    <div class="max-w-5xl mx-auto px-6 py-20 text-center">
      <h1 class="text-5xl font-bold tracking-tight text-base-content">
        LiveFlow
      </h1>
      <p class="mt-4 text-xl text-base-content/60 max-w-2xl mx-auto">
        A powerful flow diagram library for Phoenix LiveView. Build interactive node-based editors
        with drag & drop, pan/zoom, connections, real-time collaboration, and more.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="#quick-start" class="btn btn-primary btn-lg">Get Started</a>
        <a href="#demos" class="btn btn-outline btn-lg">View Demos</a>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-16">
    <%!-- Table of Contents --%>
    <nav id="toc" class="mb-16 rounded-box border border-base-300 p-6 bg-base-200/30">
      <h2 class="text-lg font-bold text-base-content mb-4">Table of Contents</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 text-sm">
        <a href="#quick-start" class="link link-hover text-primary">1. Quick Start</a>
        <a href="#core-concepts" class="link link-hover text-primary">2. Core Concepts</a>
        <a href="#building-a-flow" class="link link-hover text-primary">3. Building a Flow</a>
        <a href="#nodes" class="link link-hover text-primary">4. Nodes</a>
        <a href="#custom-nodes" class="link link-hover text-primary">5. Custom Nodes</a>
        <a href="#edges" class="link link-hover text-primary">6. Edges & Path Types</a>
        <a href="#handles" class="link link-hover text-primary">7. Handles & Connections</a>
        <a href="#viewport" class="link link-hover text-primary">8. The Viewport</a>
        <a href="#interactivity" class="link link-hover text-primary">9. Interactivity</a>
        <a href="#state-management" class="link link-hover text-primary">10. State Management</a>
        <a href="#history" class="link link-hover text-primary">11. History (Undo/Redo)</a>
        <a href="#clipboard" class="link link-hover text-primary">12. Clipboard</a>
        <a href="#serialization" class="link link-hover text-primary">13. Serialization</a>
        <a href="#layout" class="link link-hover text-primary">14. Auto Layout</a>
        <a href="#validation" class="link link-hover text-primary">15. Connection Validation</a>
        <a href="#collaboration" class="link link-hover text-primary">16. Real-time Collaboration</a>
        <a href="#js-hooks" class="link link-hover text-primary">17. JavaScript Architecture</a>
        <a href="#theming" class="link link-hover text-primary">18. Theming</a>
        <a href="#demos" class="link link-hover text-primary">19. Demos</a>
      </div>
    </nav>

    <%!-- ================================================================ --%>
    <%!-- 1. QUICK START --%>
    <%!-- ================================================================ --%>
    <section id="quick-start" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        1. Quick Start
      </h2>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Installation</h3>
      <p class="text-base-content/70 mb-4">
        Add <code class="badge badge-ghost">live_flow</code> to your dependencies in
        <code class="badge badge-ghost">mix.exs</code>:
      </p>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">defp deps do
  [
    {:live_flow, "~&gt; 0.2.3"}
    # or for local development:
    # {:live_flow, path: "../live_flow"}
  ]
end</code></pre>

      <p class="text-base-content/70 mb-4">
        Then install dependencies and import the JS/CSS assets:
      </p>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6"><code class="text-base-content">$ mix deps.get</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">JavaScript Setup</h3>
      <p class="text-base-content/70 mb-4">
        In your <code class="badge badge-ghost">assets/js/app.js</code>, import and register the LiveFlow hook:
      </p>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">import { LiveFlowHook, FileImportHook, setupDownloadHandler } from "live_flow"

let liveSocket = new LiveSocket("/live", Socket, {
  hooks: {
    LiveFlow: LiveFlowHook,
    FileImportHook: FileImportHook,
    // ...your other hooks
  },
  // ...
})

// Enable file download support (for JSON export)
setupDownloadHandler(liveSocket)</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">CSS Setup</h3>
      <p class="text-base-content/70 mb-4">
        Import the LiveFlow styles in your <code class="badge badge-ghost">assets/css/app.css</code>:
      </p>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">@import "../../deps/live_flow/assets/css/live_flow.css";</code></pre>

      <div class="alert alert-info mt-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <p class="font-semibold">Two things to pay attention to:</p>
          <ol class="list-decimal list-inside mt-1 text-sm">
            <li>The LiveFlow CSS must be imported for proper styling of nodes, edges, and controls.</li>
            <li>The Flow component needs a parent container with defined dimensions (width/height).</li>
          </ol>
        </div>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 2. CORE CONCEPTS --%>
    <%!-- ================================================================ --%>
    <section id="core-concepts" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        2. Core Concepts
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow is built around a few fundamental concepts. Understanding these will help you
        build powerful flow-based interfaces.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-box border border-base-300 p-5">
          <h3 class="text-lg font-semibold text-primary mb-2">Nodes</h3>
          <p class="text-sm text-base-content/70">
            Draggable elements on the canvas. Each node has a position, type, data, and optional handles
            for connections. Nodes can be default, custom function components, or LiveComponents.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-5">
          <h3 class="text-lg font-semibold text-primary mb-2">Edges</h3>
          <p class="text-sm text-base-content/70">
            Connections between nodes. Edges connect a source node/handle to a target node/handle.
            Support four path types: bezier, straight, step, and smoothstep.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-5">
          <h3 class="text-lg font-semibold text-primary mb-2">Handles</h3>
          <p class="text-sm text-base-content/70">
            Connection points on nodes. Handles define where edges can attach.
            They have a type (<code>:source</code> or <code>:target</code>) and a position
            (<code>:top</code>, <code>:bottom</code>, <code>:left</code>, <code>:right</code>).
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-5">
          <h3 class="text-lg font-semibold text-primary mb-2">Viewport</h3>
          <p class="text-sm text-base-content/70">
            The visible area of the canvas. Users can pan (scroll) and zoom to navigate
            the flow. The viewport tracks x, y offset and zoom level.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-5">
          <h3 class="text-lg font-semibold text-primary mb-2">State</h3>
          <p class="text-sm text-base-content/70">
            A centralized struct (<code>LiveFlow.State</code>) that holds all nodes, edges,
            viewport, and selections. All modifications go through state functions.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-5">
          <h3 class="text-lg font-semibold text-primary mb-2">Changes</h3>
          <p class="text-sm text-base-content/70">
            The XYFlow pattern: JS sends change lists to the server, which applies them
            to the state. This enables optimistic UI updates with server reconciliation.
          </p>
        </div>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 3. BUILDING A FLOW --%>
    <%!-- ================================================================ --%>
    <section id="building-a-flow" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        3. Building a Flow
      </h2>

      <p class="text-base-content/70 mb-6">
        A basic flow requires a LiveView that manages the state and renders the Flow component.
        Here's a minimal example:
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">LiveView Module</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">defmodule MyAppWeb.MyFlowLive do
  use MyAppWeb, :live_view

  alias LiveFlow
  alias LiveFlow.Changes.NodeChange
  alias LiveFlow.Changes.EdgeChange

  @impl true
  def mount(_params, _session, socket) do
    # Create initial nodes
    nodes = [
      LiveFlow.new_node("1", %{x: 0, y: 0}, %{label: "Input"}),
      LiveFlow.new_node("2", %{x: 250, y: 100}, %{label: "Process"}),
      LiveFlow.new_node("3", %{x: 500, y: 0}, %{label: "Output"})
    ]

    # Create edges connecting the nodes
    edges = [
      LiveFlow.new_edge("1", "2", "e1-2"),
      LiveFlow.new_edge("2", "3", "e2-3")
    ]

    # Initialize the flow state
    flow = LiveFlow.create_flow(nodes: nodes, edges: edges)

    {:ok, assign(socket, flow: flow)}
  end

  @impl true
  def render(assigns) do
    ~H"""
    &lt;Layouts.app flash={@flash}&gt;
      &lt;div style="width: 100%; height: 80vh;"&gt;
        &lt;.live_component
          module={LiveFlow.Components.Flow}
          id="my-flow"
          flow={@flow}
        /&gt;
      &lt;/div&gt;
    &lt;/Layouts.app&gt;
    """
  end

  # Handle node changes (position, dimensions, selection, removal)
  @impl true
  def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
    flow = NodeChange.apply_changes(socket.assigns.flow, changes)
    {:noreply, assign(socket, flow: flow)}
  end

  # Handle edge changes (add, remove, select)
  def handle_event("lf:edge_change", %{"changes" =&gt; changes}, socket) do
    flow = EdgeChange.apply_changes(socket.assigns.flow, changes)
    {:noreply, assign(socket, flow: flow)}
  end

  # Catch-all for other LiveFlow events
  def handle_event("lf:" &lt;&gt; _event, _params, socket) do
    {:noreply, socket}
  end
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Router</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># In your router.ex
scope "/", MyAppWeb do
  pipe_through :browser

  live "/my-flow", MyFlowLive
end</code></pre>

      <div class="alert alert-warning mt-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
          <p class="text-sm">
            <span class="font-semibold">Important:</span> The parent <code>&lt;div&gt;</code> of the Flow component
            <strong>must have explicit dimensions</strong> (width and height). Without them, the canvas won't render.
          </p>
        </div>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 4. NODES --%>
    <%!-- ================================================================ --%>
    <section id="nodes" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        4. Nodes
      </h2>

      <p class="text-base-content/70 mb-6">
        Nodes are the building blocks of a flow. Each node is a struct with position, type, data,
        and behavior flags.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Node Struct</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">%LiveFlow.Node{
  id: "node-1",              # Unique identifier (required)
  type: :default,            # :default or custom atom
  position: %{x: 100, y: 100},  # Position on canvas
  data: %{label: "My Node"},    # Arbitrary data map
  width: nil,                # Auto-measured by JS
  height: nil,               # Auto-measured by JS
  selected: false,           # Selection state
  draggable: true,           # Can be dragged?
  connectable: true,         # Can connect edges?
  selectable: true,          # Can be selected?
  deletable: true,           # Can be deleted?
  hidden: false,             # Visibility
  dragging: false,           # Currently being dragged?
  parent_id: nil,            # For nested/sub-flow nodes
  handles: [],               # List of Handle structs
  style: nil,                # Inline CSS styles
  class: nil,                # CSS class names
  z_index: 0                 # Stacking order
}</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Creating Nodes</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Basic node
node = LiveFlow.new_node("1", %{x: 0, y: 0}, %{label: "Hello"})

# Node with options
node = LiveFlow.new_node("2", %{x: 250, y: 100}, %{label: "World"},
  type: :card,
  draggable: true,
  connectable: true,
  class: "my-custom-class"
)

# Node with handles
node = LiveFlow.new_node("3", %{x: 500, y: 0}, %{label: "Output"},
  handles: [
    LiveFlow.new_handle("input", :target, position: :left),
    LiveFlow.new_handle("output", :source, position: :right)
  ]
)</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Node Operations</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Add a node to the flow
flow = LiveFlow.State.add_node(flow, node)

# Update a node
flow = LiveFlow.State.update_node(flow, "node-1", %{position: %{x: 200, y: 300}})

# Update with a function
flow = LiveFlow.State.update_node(flow, "node-1", fn node -&gt;
  %{node | data: Map.put(node.data, :label, "Updated!")}
end)

# Remove a node (also removes connected edges)
flow = LiveFlow.State.remove_node(flow, "node-1")

# Select a node
flow = LiveFlow.State.select_node(flow, "node-1")

# Multi-select
flow = LiveFlow.State.select_node(flow, "node-2", multi: true)

# Clear all selections
flow = LiveFlow.State.clear_selection(flow)

# Delete all selected nodes and edges
flow = LiveFlow.State.delete_selected(flow)</code></pre>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 5. CUSTOM NODES --%>
    <%!-- ================================================================ --%>
    <section id="custom-nodes" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        5. Custom Nodes
      </h2>

      <p class="text-base-content/70 mb-6">
        Custom nodes let you render any HEEx content inside a node. You can use function components
        or LiveComponents. Pass them via the <code class="badge badge-ghost">node_types</code> attribute.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Function Component Node</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Define a custom node as a function component
defp card_node(assigns) do
  ~H"""
  &lt;div class="bg-white rounded-lg shadow-lg p-4 min-w-[200px] border-2 border-blue-400"&gt;
    &lt;div class="flex items-center gap-2 mb-2"&gt;
      &lt;div class="w-3 h-3 rounded-full bg-blue-500"&gt;&lt;/div&gt;
      &lt;span class="font-bold text-gray-800"&gt;{@data.label}&lt;/span&gt;
    &lt;/div&gt;
    &lt;p class="text-sm text-gray-600"&gt;{Map.get(@data, :description, "")}&lt;/p&gt;

    &lt;%!-- Render handles for this node --%&gt;
    &lt;LiveFlow.Components.Handle.handle
      id="target"
      type={:target}
      position={:left}
    /&gt;
    &lt;LiveFlow.Components.Handle.handle
      id="source"
      type={:source}
      position={:right}
    /&gt;
  &lt;/div&gt;
  """
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Registering Custom Nodes</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># In your render function, pass node_types to the Flow component
&lt;.live_component
  module={LiveFlow.Components.Flow}
  id="my-flow"
  flow={@flow}
  node_types={%{card: &card_node/1}}
/&gt;

# Then create nodes with that type
node = LiveFlow.new_node("1", %{x: 0, y: 0},
  %{label: "Custom Card", description: "This is a custom node"},
  type: :card
)</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Available Assigns in Custom Nodes</h3>
      <p class="text-base-content/70 mb-4">
        Your custom node component receives these assigns:
      </p>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Assign</th>
              <th>Type</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><code>@id</code></td><td>string</td><td>The node's unique ID</td></tr>
            <tr><td><code>@data</code></td><td>map</td><td>The node's data map</td></tr>
            <tr><td><code>@type</code></td><td>atom</td><td>The node type</td></tr>
            <tr><td><code>@selected</code></td><td>boolean</td><td>Whether the node is selected</td></tr>
            <tr><td><code>@dragging</code></td><td>boolean</td><td>Whether the node is being dragged</td></tr>
            <tr><td><code>@connectable</code></td><td>boolean</td><td>Whether the node accepts connections</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">SVG Shape Nodes</h3>
      <p class="text-base-content/70 mb-4">
        For flowchart-style diagrams, you can create nodes with custom SVG shapes:
      </p>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">defp diamond_node(assigns) do
  ~H"""
  &lt;div class="relative" style="width: 120px; height: 120px;"&gt;
    &lt;svg viewBox="0 0 120 120" class="absolute inset-0"&gt;
      &lt;polygon
        points="60,5 115,60 60,115 5,60"
        fill="white"
        stroke="#6366f1"
        stroke-width="2"
      /&gt;
    &lt;/svg&gt;
    &lt;div class="absolute inset-0 flex items-center justify-center"&gt;
      &lt;span class="text-sm font-medium"&gt;{@data.label}&lt;/span&gt;
    &lt;/div&gt;
    &lt;LiveFlow.Components.Handle.handle id="top" type={:target} position={:top} /&gt;
    &lt;LiveFlow.Components.Handle.handle id="bottom" type={:source} position={:bottom} /&gt;
  &lt;/div&gt;
  """
end</code></pre>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 6. EDGES & PATH TYPES --%>
    <%!-- ================================================================ --%>
    <section id="edges" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        6. Edges & Path Types
      </h2>

      <p class="text-base-content/70 mb-6">
        Edges are the connections between nodes. They connect a source handle to a target handle
        and are rendered as SVG paths.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Edge Struct</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">%LiveFlow.Edge{
  id: "edge-1",                  # Unique identifier
  source: "node-1",              # Source node ID
  target: "node-2",              # Target node ID
  source_handle: "source",       # Source handle ID
  target_handle: "target",       # Target handle ID
  type: :bezier,                 # Path type
  animated: false,               # Animated dashed line?
  selected: false,
  selectable: true,
  deletable: true,
  marker_end: %{type: :arrow},   # Arrowhead at target
  interaction_width: 20,         # Invisible hit area width
  label: nil,                    # Text label on the edge
  label_position: 0.5,           # 0.0 to 1.0 along path
  data: %{},                     # Custom data
  path_options: nil              # Extra path config
}</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Creating Edges</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Basic edge (auto-generates ID)
edge = LiveFlow.new_edge("node-1", "node-2")

# Edge with explicit ID
edge = LiveFlow.new_edge("node-1", "node-2", "my-edge")

# Edge with options
edge = LiveFlow.new_edge("node-1", "node-2", "my-edge",
  type: :smoothstep,
  animated: true,
  label: "connects to",
  source_handle: "output-1",
  target_handle: "input-1",
  marker_end: %{type: :arrow_closed}
)

# Add to flow
flow = LiveFlow.State.add_edge(flow, edge)

# Remove from flow
flow = LiveFlow.State.remove_edge(flow, "my-edge")</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Path Types</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div class="rounded-box border border-base-300 p-4">
          <h4 class="font-semibold text-base-content mb-2">
            <code>:bezier</code>
            <span class="badge badge-sm badge-primary ml-2">default</span>
          </h4>
          <p class="text-sm text-base-content/70">
            Cubic bezier curve. Smooth, flowing connections with automatic curvature (0.25 factor, min 50px offset).
            Best for most use cases.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-4">
          <h4 class="font-semibold text-base-content mb-2"><code>:straight</code></h4>
          <p class="text-sm text-base-content/70">
            Direct straight line from source to target. Simple and clean. Best for short, direct connections.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-4">
          <h4 class="font-semibold text-base-content mb-2"><code>:step</code></h4>
          <p class="text-sm text-base-content/70">
            Orthogonal path with 90-degree turns. Creates an L-shaped or Z-shaped path.
            Best for circuit-style or pipeline diagrams.
          </p>
        </div>

        <div class="rounded-box border border-base-300 p-4">
          <h4 class="font-semibold text-base-content mb-2"><code>:smoothstep</code></h4>
          <p class="text-sm text-base-content/70">
            Like step but with rounded corners (border_radius: 5px). Combines orthogonal routing
            with smooth transitions.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Edge Markers</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Arrow at end (default)
marker_end: %{type: :arrow}

# Closed/filled arrow
marker_end: %{type: :arrow_closed}

# Custom colored marker
marker_end: %{type: :arrow, color: "#ff0000"}</code></pre>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 7. HANDLES & CONNECTIONS --%>
    <%!-- ================================================================ --%>
    <section id="handles" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        7. Handles & Connections
      </h2>

      <p class="text-base-content/70 mb-6">
        Handles are the connection points on nodes. When a user drags from a source handle to a
        target handle, a new edge is created.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Handle Struct</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">%LiveFlow.Handle{
  id: "source",          # Handle identifier
  type: :source,         # :source (output) or :target (input)
  position: :right,      # :top | :bottom | :left | :right
  connectable: true,     # Can this handle be connected?
  connect_type: nil      # Optional type for validation (e.g., :string, :number)
}</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Creating Handles</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Basic handles
source = LiveFlow.new_handle("out", :source, position: :right)
target = LiveFlow.new_handle("in", :target, position: :left)

# Typed handles (for validation)
string_output = LiveFlow.new_handle("str-out", :source,
  position: :right,
  connect_type: :string
)
string_input = LiveFlow.new_handle("str-in", :target,
  position: :left,
  connect_type: :string
)

# Add handles to a node
node = LiveFlow.new_node("1", %{x: 0, y: 0}, %{label: "Node"},
  handles: [source, target]
)</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Rendering Handles in Custom Nodes</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Inside a custom node component
&lt;LiveFlow.Components.Handle.handle
  id="my-source"
  type={:source}
  position={:right}
/&gt;

&lt;LiveFlow.Components.Handle.handle
  id="my-target"
  type={:target}
  position={:left}
/&gt;</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Connection Events</h3>
      <p class="text-base-content/70 mb-4">
        When a user draws a connection, LiveFlow sends these events in order:
      </p>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Event</th>
              <th>When</th>
              <th>Data</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>lf:connect_start</code></td>
              <td>User starts dragging from a handle</td>
              <td>node_id, handle_id, handle_type</td>
            </tr>
            <tr>
              <td><code>lf:connect_move</code></td>
              <td>User moves while connecting</td>
              <td>x, y coordinates</td>
            </tr>
            <tr>
              <td><code>lf:connect_end</code></td>
              <td>User drops on a valid target handle</td>
              <td>source, target, source_handle, target_handle</td>
            </tr>
            <tr>
              <td><code>lf:connect_cancel</code></td>
              <td>User drops on empty space</td>
              <td>-</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 8. THE VIEWPORT --%>
    <%!-- ================================================================ --%>
    <section id="viewport" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        8. The Viewport
      </h2>

      <p class="text-base-content/70 mb-6">
        The viewport represents the visible area of the flow canvas. It tracks pan offset and zoom level.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Viewport Struct</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">%LiveFlow.Viewport{
  x: 0.0,      # Horizontal pan offset
  y: 0.0,      # Vertical pan offset
  zoom: 1.0    # Zoom level (1.0 = 100%)
}</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Coordinate Transforms</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Screen coordinates → Flow coordinates
# flow_x = (screen_x - viewport.x) / viewport.zoom
# flow_y = (screen_y - viewport.y) / viewport.zoom
{flow_x, flow_y} = LiveFlow.Viewport.screen_to_flow(viewport, screen_x, screen_y)

# Flow coordinates → Screen coordinates
# screen_x = flow_x * viewport.zoom + viewport.x
# screen_y = flow_y * viewport.zoom + viewport.y
{screen_x, screen_y} = LiveFlow.Viewport.flow_to_screen(viewport, flow_x, flow_y)</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Flow Component Viewport Options</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">&lt;.live_component
  module={LiveFlow.Components.Flow}
  id="my-flow"
  flow={@flow}
  pan_on_drag={true}        # Enable panning by dragging canvas
  zoom_on_scroll={true}     # Enable zoom with scroll wheel
  min_zoom={0.1}            # Minimum zoom level (10%)
  max_zoom={4.0}            # Maximum zoom level (400%)
  fit_view_on_init={true}   # Auto-fit all nodes on load
/&gt;</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Programmatic Viewport Control</h3>
      <p class="text-base-content/70 mb-4">
        Push events from the server to control the viewport:
      </p>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Fit all nodes in view
socket = push_event(socket, "lf:fit_view", %{padding: 50})

# Zoom to specific level
socket = push_event(socket, "lf:zoom_to", %{zoom: 1.5})

# Pan to position
socket = push_event(socket, "lf:pan_to", %{x: 100, y: 200})

# Set exact viewport
socket = push_event(socket, "lf:set_viewport", %{x: 0, y: 0, zoom: 1.0})</code></pre>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 9. INTERACTIVITY --%>
    <%!-- ================================================================ --%>
    <section id="interactivity" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        9. Interactivity
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow provides rich interactivity out of the box: dragging, selection, keyboard shortcuts,
        and built-in UI controls.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Flow Component Options</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">&lt;.live_component
  module={LiveFlow.Components.Flow}
  id="my-flow"
  flow={@flow}

  # Viewport
  pan_on_drag={true}
  zoom_on_scroll={true}
  min_zoom={0.1}
  max_zoom={4.0}
  fit_view_on_init={false}

  # Grid
  snap_to_grid={false}
  snap_grid={{15, 15}}

  # UI Components
  background={:dots}         # :dots | :lines | :cross | nil
  minimap={true}             # Show minimap
  controls={true}            # Show zoom controls
  helper_lines={true}        # Show alignment guides

  # Custom node types
  node_types={%{card: &card_node/1}}

  # Theme
  theme="dark"               # "dark" | "light" | custom
/&gt;</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Built-in Keyboard Shortcuts</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th>Shortcut</th><th>Action</th></tr>
          </thead>
          <tbody>
            <tr><td><kbd class="kbd kbd-sm">Delete</kbd> / <kbd class="kbd kbd-sm">Backspace</kbd></td><td>Delete selected nodes/edges</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">Z</kbd></td><td>Undo</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">Shift</kbd>+<kbd class="kbd kbd-sm">Z</kbd></td><td>Redo</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">C</kbd></td><td>Copy selected</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">X</kbd></td><td>Cut selected</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">V</kbd></td><td>Paste</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">D</kbd></td><td>Duplicate selected</td></tr>
            <tr><td><kbd class="kbd kbd-sm">Ctrl</kbd>+<kbd class="kbd kbd-sm">A</kbd></td><td>Select all</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Selection</h3>
      <p class="text-base-content/70 mb-4">
        Users can select nodes/edges by clicking, or use rubber-band (box) selection by dragging
        on the canvas background. Hold <kbd class="kbd kbd-sm">Shift</kbd> for multi-select.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Helper Lines</h3>
      <p class="text-base-content/70 mb-4">
        When <code class="badge badge-ghost">helper_lines={true}</code>, alignment guides appear
        as you drag nodes, helping you snap to other nodes' edges and centers.
      </p>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 10. STATE MANAGEMENT --%>
    <%!-- ================================================================ --%>
    <section id="state-management" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        10. State Management
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow follows the XYFlow change pattern: JS detects user interactions, sends change lists
        to the server, and the server applies them to the state.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">The State Struct</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">%LiveFlow.State{
  nodes: %{"id" =&gt; %Node{}},           # Map of nodes by ID
  edges: %{"id" =&gt; %Edge{}},           # Map of edges by ID
  viewport: %Viewport{x: 0, y: 0, zoom: 1.0},
  selected_nodes: MapSet.new(),        # Set of selected node IDs
  selected_edges: MapSet.new()         # Set of selected edge IDs
}</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Applying Changes from JS</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Changes.{NodeChange, EdgeChange}

# Handle node changes (position, dimensions, select, remove)
def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
  flow = NodeChange.apply_changes(socket.assigns.flow, changes)
  {:noreply, assign(socket, flow: flow)}
end

# Handle edge changes (add, remove, select)
def handle_event("lf:edge_change", %{"changes" =&gt; changes}, socket) do
  flow = EdgeChange.apply_changes(socket.assigns.flow, changes)
  {:noreply, assign(socket, flow: flow)}
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Change Types</h3>
      <p class="text-base-content/70 mb-4">
        Node changes can include:
      </p>
      <ul class="list-disc list-inside text-base-content/70 space-y-1 mb-4">
        <li><strong>position</strong> — node moved to new x, y</li>
        <li><strong>dimensions</strong> — node width/height measured by ResizeObserver</li>
        <li><strong>select</strong> — node selected or deselected</li>
        <li><strong>remove</strong> — node deleted</li>
      </ul>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Data Flow Architecture</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6"><code class="text-base-content">User Action
  → JS Manager (optimistic UI update)
  → pushEventTo("lf:event_name", data)
  → LiveComponent.handle_event/3
  → State update
  → DOM patch
  → Hook.updated()
  → Re-measure nodes if needed</code></pre>

      <div class="alert alert-info mt-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm">
          <span class="font-semibold">Optimistic updates:</span> During drag, node positions are updated via CSS
          <code>style.left/top</code> directly — no server roundtrips. Edge SVG paths are recalculated in JS
          to keep them visually connected. The final position is only sent once on drag end.
        </p>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 11. HISTORY (UNDO/REDO) --%>
    <%!-- ================================================================ --%>
    <section id="history" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        11. History (Undo/Redo)
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow includes a built-in history system for undo/redo functionality using snapshot stacks.
      </p>

      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.History

# Initialize history in mount
def mount(_params, _session, socket) do
  flow = LiveFlow.create_flow(nodes: nodes, edges: edges)
  history = History.new()

  {:ok, assign(socket, flow: flow, history: history)}
end

# Push state to history before changes
def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
  history = History.push(socket.assigns.history, socket.assigns.flow)
  flow = NodeChange.apply_changes(socket.assigns.flow, changes)

  {:noreply, assign(socket, flow: flow, history: history)}
end

# Undo
def handle_event("lf:undo", _params, socket) do
  case History.undo(socket.assigns.history, socket.assigns.flow) do
    {:ok, flow, history} -&gt;
      {:noreply, assign(socket, flow: flow, history: history)}
    :error -&gt;
      {:noreply, socket}
  end
end

# Redo
def handle_event("lf:redo", _params, socket) do
  case History.redo(socket.assigns.history, socket.assigns.flow) do
    {:ok, flow, history} -&gt;
      {:noreply, assign(socket, flow: flow, history: history)}
    :error -&gt;
      {:noreply, socket}
  end
end</code></pre>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 12. CLIPBOARD --%>
    <%!-- ================================================================ --%>
    <section id="clipboard" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        12. Clipboard (Copy/Cut/Paste)
      </h2>

      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Clipboard

# Initialize clipboard in mount
def mount(_params, _session, socket) do
  {:ok, assign(socket, clipboard: Clipboard.new(), paste_count: 0)}
end

# Copy selected nodes/edges
def handle_event("lf:copy", _params, socket) do
  {clipboard, flow} = Clipboard.copy(socket.assigns.flow, socket.assigns.clipboard)
  {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
end

# Cut selected nodes/edges
def handle_event("lf:cut", _params, socket) do
  {clipboard, flow} = Clipboard.cut(socket.assigns.flow, socket.assigns.clipboard)
  {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
end

# Paste with offset
def handle_event("lf:paste", _params, socket) do
  paste_count = socket.assigns.paste_count + 1
  {flow, clipboard} = Clipboard.paste(
    socket.assigns.flow,
    socket.assigns.clipboard,
    paste_count
  )
  {:noreply, assign(socket, flow: flow, clipboard: clipboard, paste_count: paste_count)}
end</code></pre>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 13. SERIALIZATION --%>
    <%!-- ================================================================ --%>
    <section id="serialization" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        13. Serialization (Import/Export)
      </h2>

      <p class="text-base-content/70 mb-6">
        Export your flow as JSON for persistence, or import from JSON to restore a flow.
      </p>

      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Serializer

# Export to JSON string
json = Serializer.to_json(flow)

# Import from JSON string
{:ok, flow} = Serializer.from_json(json)

# Export as file download (push to JS)
def handle_event("export", _params, socket) do
  json = Serializer.to_json(socket.assigns.flow)
  {:noreply, push_event(socket, "phx:lf:download_file", %{
    content: json,
    filename: "my-flow.json",
    content_type: "application/json"
  })}
end

# Import from file upload
def handle_event("import", %{"json" =&gt; json}, socket) do
  case Serializer.from_json(json) do
    {:ok, flow} -&gt;
      {:noreply, assign(socket, flow: flow)}
    {:error, reason} -&gt;
      {:noreply, put_flash(socket, :error, "Import failed: #{reason}")}
  end
end</code></pre>

      <div class="alert alert-info mt-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-sm">
          For file import, use the <code>FileImportHook</code> registered in your app.js.
          It provides a file input that reads the JSON content and pushes it to the server.
        </p>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 14. AUTO LAYOUT --%>
    <%!-- ================================================================ --%>
    <section id="layout" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        14. Auto Layout
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow includes auto-layout powered by the ELK (Eclipse Layout Kernel) algorithm,
        which runs client-side for optimal performance.
      </p>

      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Layout

# Prepare layout data (server-side)
# This creates the node/edge structure ELK needs
layout_data = Layout.prepare_elk_data(flow, direction: "DOWN")

# Push to client for ELK computation
socket = push_event(socket, "lf:layout_data", layout_data)

# Handle the computed layout positions from JS
def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
  flow = NodeChange.apply_changes(socket.assigns.flow, changes)
  {:noreply, assign(socket, flow: flow)}
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Layout Directions</h3>
      <div class="flex gap-2 flex-wrap">
        <span class="badge badge-outline">"DOWN" — Top to bottom</span>
        <span class="badge badge-outline">"RIGHT" — Left to right</span>
        <span class="badge badge-outline">"UP" — Bottom to top</span>
        <span class="badge badge-outline">"LEFT" — Right to left</span>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 15. CONNECTION VALIDATION --%>
    <%!-- ================================================================ --%>
    <section id="validation" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        15. Connection Validation
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow provides composable validators to control which connections are allowed.
      </p>

      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Validation

# Validate a connection with built-in validators
validators = [
  :no_duplicate_edges,     # Prevent duplicate connections
  :nodes_exist,            # Ensure both nodes exist
  :handles_valid,          # Ensure handles exist on nodes
  :types_compatible,       # Check handle connect_type matches
  :no_cycles,              # Prevent circular connections
  {:max_connections, 3}    # Max 3 connections per handle
]

# Use in connect_end handler
def handle_event("lf:connect_end", params, socket) do
  case Validation.Connection.validate_and_create(
    socket.assigns.flow, params, validators
  ) do
    {:ok, edge} -&gt;
      flow = LiveFlow.State.add_edge(socket.assigns.flow, edge)
      {:noreply, assign(socket, flow: flow)}

    {:error, reason} -&gt;
      {:noreply, put_flash(socket, :error, "Connection failed: #{reason}")}
  end
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Built-in Validators</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th>Validator</th><th>Description</th></tr>
          </thead>
          <tbody>
            <tr><td><code>:no_duplicate_edges</code></td><td>Prevents creating the same connection twice</td></tr>
            <tr><td><code>:nodes_exist</code></td><td>Verifies both source and target nodes exist</td></tr>
            <tr><td><code>:handles_valid</code></td><td>Verifies the referenced handles exist on the nodes</td></tr>
            <tr><td><code>:types_compatible</code></td><td>Checks that handle <code>connect_type</code> values match</td></tr>
            <tr><td><code>:no_cycles</code></td><td>Prevents circular/cyclic connections</td></tr>
            <tr>
              <td><code phx-no-curly-interpolation>{:max_connections, n}</code></td>
              <td>Limits the number of connections per handle to <code>n</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 16. REAL-TIME COLLABORATION --%>
    <%!-- ================================================================ --%>
    <section id="collaboration" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        16. Real-time Collaboration
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow supports real-time collaboration via Phoenix PubSub and Presence.
        Multiple users can edit the same flow simultaneously with live cursors and
        synchronized changes.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Setup</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">alias LiveFlow.Collaboration
alias LiveFlow.Collaboration.User

def mount(_params, _session, socket) do
  # Create a collaboration user
  user = %User{
    id: socket.id,
    name: "User #{:rand.uniform(999)}",
    color: Enum.random(~w(#ef4444 #3b82f6 #10b981 #f59e0b #8b5cf6))
  }

  # Join the collaboration room
  socket = Collaboration.join(socket, "my-room", MyApp.PubSub, user)

  flow = LiveFlow.create_flow(nodes: nodes, edges: edges)
  {:ok, assign(socket, flow: flow)}
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Broadcasting Changes</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># Broadcast node changes to other users
def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
  flow = NodeChange.apply_changes(socket.assigns.flow, changes)
  Collaboration.broadcast_change(socket, {:node_changes, changes})
  {:noreply, assign(socket, flow: flow)}
end

# Broadcast drag movements (throttled)
def handle_event("lf:drag_move", %{"changes" =&gt; changes}, socket) do
  Collaboration.broadcast_drag_move(socket, changes)
  {:noreply, socket}
end

# Broadcast cursor position
def handle_event("lf:cursor_move", %{"x" =&gt; x, "y" =&gt; y}, socket) do
  Collaboration.broadcast_cursor(socket, x, y)
  {:noreply, socket}
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Handling Remote Changes</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content"># In handle_info/2 — delegate to Collaboration module
def handle_info(msg, socket) do
  Collaboration.handle_info(msg, socket)
end</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">PubSub Topics</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th>Topic</th><th>Purpose</th><th>Frequency</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><code>"flow:room_id"</code></td>
              <td>Node/edge changes</td>
              <td>On user action</td>
            </tr>
            <tr>
              <td><code>"flow:room_id:cursors"</code></td>
              <td>Cursor movements</td>
              <td>Throttled (50ms server-side)</td>
            </tr>
            <tr>
              <td><code>"flow:room_id:presence"</code></td>
              <td>Join/leave events</td>
              <td>On connect/disconnect</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Client-side Interpolation</h3>
      <p class="text-base-content/70 mb-4">
        Remote movements are smoothly interpolated on the client using linear interpolation (lerp):
      </p>
      <ul class="list-disc list-inside text-base-content/70 space-y-1">
        <li><strong>Remote drag:</strong> lerp factor 0.40 via <code>requestAnimationFrame</code></li>
        <li><strong>Remote cursors:</strong> lerp factor 0.35, SVG arrow with colored name label</li>
      </ul>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 17. JAVASCRIPT ARCHITECTURE --%>
    <%!-- ================================================================ --%>
    <section id="js-hooks" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        17. JavaScript Architecture
      </h2>

      <p class="text-base-content/70 mb-6">
        The JavaScript layer handles all client-side interactions through a modular manager system,
        orchestrated by the main <code>LiveFlowHook</code>.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Manager System</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th>Manager</th><th>Responsibility</th></tr>
          </thead>
          <tbody>
            <tr><td><code>PanZoomManager</code></td><td>Canvas panning and zooming with wheel/touch events</td></tr>
            <tr><td><code>NodeDragManager</code></td><td>Node dragging with CSS transforms, multi-select drag</td></tr>
            <tr><td><code>ConnectionManager</code></td><td>Drawing connections between handles with preview line</td></tr>
            <tr><td><code>SelectionManager</code></td><td>Click and rubber-band selection</td></tr>
            <tr><td><code>CursorManager</code></td><td>Remote cursor rendering for collaboration</td></tr>
            <tr><td><code>HelperLinesManager</code></td><td>Snap alignment guides during drag</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Event Flow (JS → Server)</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">// All events use pushEventTo to target the LiveComponent
this.pushEventTo(this.el, "lf:node_change", {changes: [...]})
this.pushEventTo(this.el, "lf:edge_change", {changes: [...]})
this.pushEventTo(this.el, "lf:viewport_change", {viewport: {...}})
this.pushEventTo(this.el, "lf:connect_end", {source, target, ...})
this.pushEventTo(this.el, "lf:delete_selected", {})
this.pushEventTo(this.el, "lf:undo", {})
this.pushEventTo(this.el, "lf:redo", {})</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Event Flow (Server → JS)</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">// Server pushes events that JS handles
push_event(socket, "lf:fit_view", %{padding: 50})
push_event(socket, "lf:zoom_to", %{zoom: 1.5})
push_event(socket, "lf:pan_to", %{x: 100, y: 200})
push_event(socket, "lf:remote_cursor", %{user_id, x, y, color, name})
push_event(socket, "lf:remote_drag", %{changes: [...]})
push_event(socket, "lf:layout_data", layout_data)</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Node Measurement</h3>
      <p class="text-base-content/70 mb-4">
        Nodes are automatically measured using <code>ResizeObserver</code> when they appear in the DOM.
        A <code>MutationObserver</code> detects new nodes and triggers measurement. The measured dimensions
        are sent back to the server as dimension changes.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Performance Optimizations</h3>
      <ul class="list-disc list-inside text-base-content/70 space-y-2">
        <li><strong>Direct CSS updates during drag</strong> — node positions use <code>style.left/top</code> without server roundtrips</li>
        <li><strong>JS edge path recalculation</strong> — edge SVG paths update in JS during drag to stay visually connected</li>
        <li><strong>Final position on drag end</strong> — only the final position is sent to the server</li>
        <li><strong>Throttled cursor updates</strong> — collaboration cursors throttled at 50ms</li>
        <li><strong>Lerp interpolation</strong> — smooth remote animations via <code>requestAnimationFrame</code></li>
      </ul>
    </section>

    <%!-- ================================================================ --%>
    <%!-- 18. THEMING --%>
    <%!-- ================================================================ --%>
    <section id="theming" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        18. Theming
      </h2>

      <p class="text-base-content/70 mb-6">
        LiveFlow uses CSS custom properties for theming via the <code class="badge badge-ghost">data-lf-theme</code>
        attribute. You can use built-in themes or create custom ones.
      </p>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Using Themes</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">&lt;.live_component
  module={LiveFlow.Components.Flow}
  id="my-flow"
  flow={@flow}
  theme="dark"      # "dark" | "light" | custom name
/&gt;</code></pre>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">CSS Custom Properties</h3>
      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm mb-6" phx-no-curly-interpolation><code class="text-base-content">/* Create a custom theme */
[data-lf-theme="my-theme"] {
  --lf-background: #1a1a2e;
  --lf-node-background: #16213e;
  --lf-node-border: #0f3460;
  --lf-node-text: #e2e8f0;
  --lf-edge-stroke: #4a5568;
  --lf-edge-stroke-selected: #63b3ed;
  --lf-handle-background: #4299e1;
  --lf-handle-border: #2b6cb0;
  --lf-selection-background: rgba(66, 153, 225, 0.1);
  --lf-minimap-background: #2d3748;
  --lf-controls-background: #2d3748;
  --lf-grid-pattern: #2d3748;
}</code></pre>
    </section>

