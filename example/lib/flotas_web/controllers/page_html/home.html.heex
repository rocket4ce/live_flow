    <%!-- ================================================================ --%>
    <%!-- COMPLETE EVENT REFERENCE --%>
    <%!-- ================================================================ --%>
    <section id="event-reference" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        Event Reference
      </h2>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">JS → Server Events</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th>Event</th><th>Description</th></tr>
          </thead>
          <tbody>
            <tr><td><code>lf:node_change</code></td><td>Position, dimensions, select, remove changes</td></tr>
            <tr><td><code>lf:edge_change</code></td><td>Add, remove, select edge changes</td></tr>
            <tr><td><code>lf:viewport_change</code></td><td>Pan/zoom viewport updates</td></tr>
            <tr><td><code>lf:connect_start</code></td><td>User starts dragging from a handle</td></tr>
            <tr><td><code>lf:connect_move</code></td><td>Connection line being drawn</td></tr>
            <tr><td><code>lf:connect_end</code></td><td>Connection completed on target handle</td></tr>
            <tr><td><code>lf:connect_cancel</code></td><td>Connection dropped on empty space</td></tr>
            <tr><td><code>lf:selection_change</code></td><td>Selection state changed</td></tr>
            <tr><td><code>lf:selection_box_start/move/end</code></td><td>Rubber-band selection</td></tr>
            <tr><td><code>lf:delete_selected</code></td><td>Delete/Backspace key pressed</td></tr>
            <tr><td><code>lf:undo</code></td><td>Ctrl+Z pressed</td></tr>
            <tr><td><code>lf:redo</code></td><td>Ctrl+Shift+Z pressed</td></tr>
            <tr><td><code>lf:copy</code></td><td>Ctrl+C pressed</td></tr>
            <tr><td><code>lf:cut</code></td><td>Ctrl+X pressed</td></tr>
            <tr><td><code>lf:paste</code></td><td>Ctrl+V pressed</td></tr>
            <tr><td><code>lf:duplicate</code></td><td>Ctrl+D pressed</td></tr>
            <tr><td><code>lf:edge_label_change</code></td><td>Inline edge label edited</td></tr>
            <tr><td><code>lf:insert_on_edge</code></td><td>"+" button clicked on edge</td></tr>
            <tr><td><code>lf:cursor_move</code></td><td>Cursor position (collaboration)</td></tr>
            <tr><td><code>lf:drag_move</code></td><td>Drag position broadcast (collaboration)</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-semibold text-base-content mt-8 mb-3">Server → JS Events</h3>
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr><th>Event</th><th>Description</th></tr>
          </thead>
          <tbody>
            <tr><td><code>lf:fit_view</code></td><td>Fit all nodes in viewport</td></tr>
            <tr><td><code>lf:zoom_to</code></td><td>Set zoom level</td></tr>
            <tr><td><code>lf:pan_to</code></td><td>Pan to position</td></tr>
            <tr><td><code>lf:set_viewport</code></td><td>Set exact viewport state</td></tr>
            <tr><td><code>lf:remote_cursor</code></td><td>Render remote user cursor</td></tr>
            <tr><td><code>lf:cursor_leave</code></td><td>Remove remote cursor</td></tr>
            <tr><td><code>lf:remote_drag</code></td><td>Animate remote node drag</td></tr>
            <tr><td><code>lf:layout_data</code></td><td>Trigger ELK auto-layout</td></tr>
            <tr><td><code>phx:lf:download_file</code></td><td>Trigger file download</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- ================================================================ --%>
    <%!-- COMPLETE HANDLE EVENT PATTERN --%>
    <%!-- ================================================================ --%>
    <section id="handle-event-pattern" class="mb-20">
      <h2 class="text-3xl font-bold text-base-content mb-6 border-b border-base-300 pb-3">
        Complete LiveView Pattern
      </h2>

      <p class="text-base-content/70 mb-6">
        Here's a full-featured LiveView showing how to handle all LiveFlow events:
      </p>

      <pre class="bg-base-200 rounded-box p-4 overflow-x-auto text-sm" phx-no-curly-interpolation><code class="text-base-content">defmodule MyAppWeb.FlowEditorLive do
  use MyAppWeb, :live_view

  alias LiveFlow
  alias LiveFlow.State
  alias LiveFlow.History
  alias LiveFlow.Clipboard
  alias LiveFlow.Serializer
  alias LiveFlow.Validation
  alias LiveFlow.Changes.{NodeChange, EdgeChange}

  @validators [:no_duplicate_edges, :nodes_exist, :handles_valid, :no_cycles]

  @impl true
  def mount(_params, _session, socket) do
    nodes = [
      LiveFlow.new_node("1", %{x: 0, y: 0}, %{label: "Start"}),
      LiveFlow.new_node("2", %{x: 300, y: 100}, %{label: "End"})
    ]
    edges = [LiveFlow.new_edge("1", "2", "e1-2")]
    flow = LiveFlow.create_flow(nodes: nodes, edges: edges)

    {:ok, assign(socket,
      flow: flow,
      history: History.new(),
      clipboard: Clipboard.new(),
      paste_count: 0
    )}
  end

  @impl true
  def render(assigns) do
    ~H"""
    &lt;Layouts.app flash={@flash}&gt;
      &lt;div style="width: 100%; height: 90vh;"&gt;
        &lt;.live_component
          module={LiveFlow.Components.Flow}
          id="editor"
          flow={@flow}
          background={:dots}
          minimap={true}
          controls={true}
          helper_lines={true}
        /&gt;
      &lt;/div&gt;
    &lt;/Layouts.app&gt;
    """
  end

  # --- Node Changes ---
  @impl true
  def handle_event("lf:node_change", %{"changes" =&gt; changes}, socket) do
    history = History.push(socket.assigns.history, socket.assigns.flow)
    flow = NodeChange.apply_changes(socket.assigns.flow, changes)
    {:noreply, assign(socket, flow: flow, history: history)}
  end

  # --- Edge Changes ---
  def handle_event("lf:edge_change", %{"changes" =&gt; changes}, socket) do
    history = History.push(socket.assigns.history, socket.assigns.flow)
    flow = EdgeChange.apply_changes(socket.assigns.flow, changes)
    {:noreply, assign(socket, flow: flow, history: history)}
  end

  # --- Connection ---
  def handle_event("lf:connect_end", params, socket) do
    case Validation.Connection.validate_and_create(
      socket.assigns.flow, params, @validators
    ) do
      {:ok, edge} -&gt;
        history = History.push(socket.assigns.history, socket.assigns.flow)
        flow = State.add_edge(socket.assigns.flow, edge)
        {:noreply, assign(socket, flow: flow, history: history)}
      {:error, _reason} -&gt;
        {:noreply, socket}
    end
  end

  # --- Delete ---
  def handle_event("lf:delete_selected", _params, socket) do
    history = History.push(socket.assigns.history, socket.assigns.flow)
    flow = State.delete_selected(socket.assigns.flow)
    {:noreply, assign(socket, flow: flow, history: history)}
  end

  # --- Undo/Redo ---
  def handle_event("lf:undo", _params, socket) do
    case History.undo(socket.assigns.history, socket.assigns.flow) do
      {:ok, flow, history} -&gt;
        {:noreply, assign(socket, flow: flow, history: history)}
      :error -&gt; {:noreply, socket}
    end
  end

  def handle_event("lf:redo", _params, socket) do
    case History.redo(socket.assigns.history, socket.assigns.flow) do
      {:ok, flow, history} -&gt;
        {:noreply, assign(socket, flow: flow, history: history)}
      :error -&gt; {:noreply, socket}
    end
  end

  # --- Clipboard ---
  def handle_event("lf:copy", _p, socket) do
    {clipboard, flow} = Clipboard.copy(socket.assigns.flow, socket.assigns.clipboard)
    {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
  end

  def handle_event("lf:cut", _p, socket) do
    {clipboard, flow} = Clipboard.cut(socket.assigns.flow, socket.assigns.clipboard)
    {:noreply, assign(socket, clipboard: clipboard, flow: flow, paste_count: 0)}
  end

  def handle_event("lf:paste", _p, socket) do
    pc = socket.assigns.paste_count + 1
    {flow, clipboard} = Clipboard.paste(socket.assigns.flow, socket.assigns.clipboard, pc)
    {:noreply, assign(socket, flow: flow, clipboard: clipboard, paste_count: pc)}
  end

  # --- Export ---
  def handle_event("export", _p, socket) do
    json = Serializer.to_json(socket.assigns.flow)
    {:noreply, push_event(socket, "phx:lf:download_file", %{
      content: json, filename: "flow.json", content_type: "application/json"
    })}
  end

  # --- Catch-all for unhandled lf: events ---
  def handle_event("lf:" &lt;&gt; _event, _params, socket) do
    {:noreply, socket}
  end
end</code></pre>
    </section>

    <%!-- Back to top --%>
    <div class="text-center py-10 border-t border-base-300">
      <a href="#" class="btn btn-ghost btn-sm">Back to top</a>
      <p class="mt-4 text-sm text-base-content/40">
        LiveFlow v0.2.3 — A flow diagram library for Phoenix LiveView
      </p>
    </div>
  </div>
</div>
